# Token dari @BotFather
BOT_TOKEN=

# Lokasi database SQLite untuk menyimpan anggota yang tercatat
DB_PATH=members.db

# Jumlah mention per pesan (jangan terlalu besar, Telegram membatasi notifikasi)
TAG_BATCH_SIZE=5

# Jeda (detik) antar pesan agar tidak kena flood limit
TAG_DELAY=1.5

# true = hanya admin grup yang boleh /all
ADMIN_ONLY=true
